{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "plugins/cerberus-gate/hooks/register.ts",
    "plugins/cerberus-gate-display/hooks/register.ts",
    "plugins/cerberus-gate/tests/*.test.ts",
    "tests/*.test.ts",
    "scripts/install.ts"
  ],
  "project": [
    "plugins/**/*.ts",
    "plugins/**/*.mts",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "types/**/*.d.ts"
  ],
  "ignoreDependencies": ["claude-code", "claude-code/testing"],
  "ignoreUnresolved": ["claude-code", "claude-code-tools"]
}
