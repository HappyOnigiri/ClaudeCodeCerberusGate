{
  "plugins": ["typescript"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "rules": {
    "typescript/no-explicit-any": "error",
    "complexity": ["error", 40]
  },
  "ignorePatterns": ["types/**", "tmp/**", "node_modules/**"],
  "overrides": [
    {
      "files": ["**/*.test.*", "types/**"],
      "rules": {
        "complexity": "off"
      }
    }
  ]
}
