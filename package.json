{
  "name": "claude-code-cerberus-gate",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --type-aware --report-unused-disable-directives-severity=error",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.plugins.json",
    "lines": "node scripts/check-lines.ts",
    "docs:check": "markdownlint-cli2 '**/*.md' '#node_modules/**' '#tmp/**'",
    "validate": "claude plugin validate --strict plugins/cerberus-gate && claude plugin validate --strict plugins/cerberus-gate-display",
    "test": "claude plugin test plugins/cerberus-gate",
    "test:scripts": "node --test tests/*.test.ts",
    "check": "npm run fmt:check && npm run lint && npm run typecheck && npm run lines && npm run check:review-inputs && npm run check:architecture && npm run check:suppressions && npm run docs:check && npm run lint:workflows && npm run lint:shell && npm run lint:unused && npm run validate && npm run test && npm run test:coverage",
    "test:live": "node scripts/live-probe.ts",
    "setup:checks": "node scripts/quality/native.ts setup",
    "check:architecture": "node scripts/quality/architecture.ts",
    "check:suppressions": "node scripts/quality/suppressions.ts",
    "lint:workflows": "node scripts/quality/native.ts workflows",
    "lint:shell": "node scripts/quality/native.ts shell",
    "lint:unused": "knip",
    "test:coverage": "node scripts/quality/coverage.ts",
    "check:review-inputs": "node scripts/review-inputs.ts --check"
  },
  "devDependencies": {
    "@types/markdown-it": "14.2.0",
    "@types/node": "24.19.2",
    "knip": "6.43.0",
    "markdown-it": "14.1.1",
    "markdownlint": "0.41.1",
    "markdownlint-cli2": "0.23.2",
    "oxc-parser": "0.155.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
